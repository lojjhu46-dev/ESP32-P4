+// Patched 2026-10-06 (jc_p4_app): workspace determinism experiment — see
+// jc_p4_app/docs/HANDOVER.md. The arena roots back ALL variable/intermediate
+// tensors and is calloc'd once at build, never re-zeroed between runs; these
+// two methods expose ModelContext::root_reset() / random fill for callers that
+// must not read stale workspace memory. Weights are NOT in the arena.
+// ⚠️ memset/fill 只写 CPU 缓存（脏行滞留 L1）——P4 上部分 esp-dl 算子若走
+// DSA/DMA 直读内存会看到旧值，所以填充后统一 C2M 回写（UNALIGNED：根内存
+// 16B 对齐，不满足缓存行对齐要求）。
+#include "esp_cache.h"
+
+static void ws_writeback(void *root, size_t size)
+{
+    if (root && size) {
+        esp_cache_msync(root, size,
+                        ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_UNALIGNED);
+    }
+}
+
+void Model::zero_workspace()
+{
+    if (m_model_context) {
+        m_model_context->root_reset();
+        mem_info_t info = {};
+        (void)m_model_context->get_variable_memory_size(info);
+        ws_writeback(m_model_context->get_internal_root(), info.internal);
+        ws_writeback(m_model_context->get_psram_root(), info.psram);
+    }
+}
+
+void Model::poison_workspace()
+{
+    if (!m_model_context) {
+        return;
+    }
+    mem_info_t info = {};
+    (void)m_model_context->get_variable_memory_size(info);
+    if (m_model_context->get_internal_root() && info.internal) {
+        esp_fill_random(m_model_context->get_internal_root(), info.internal);
+        ws_writeback(m_model_context->get_internal_root(), info.internal);
+    }
+    if (m_model_context->get_psram_root() && info.psram) {
+        esp_fill_random(m_model_context->get_psram_root(), info.psram);
+        ws_writeback(m_model_context->get_psram_root(), info.psram);
+    }
+}
+
+void Model::run_trace(std::vector<uint32_t> &trace)
+{
+    trace.clear();
+    // Patch note: one CRC entry per module = CRC over the module's OUTPUT
+    // tensors' logical bytes (m_variables indexed by m_outputs_index) — this
+    // filters don't-care padding noise that made whole-arena CRCs diverge at
+    // random modules. The last entry is the whole-arena CRC.
+    if (!m_model_context) {
+        return;
+    }
+    mem_info_t info = {};
+    (void)m_model_context->get_variable_memory_size(info);
+    uint8_t *psram = (uint8_t *)m_model_context->get_psram_root();
+    uint8_t *internal = (uint8_t *)m_model_context->get_internal_root();
+    for (size_t i = 0; i < m_execution_plan.size(); i++) {
+        dl::module::Module *module = m_execution_plan[i];
+        if (!module) {
+            break;
+        }
+        module->forward(m_model_context, RUNTIME_MODE_SINGLE_CORE);
+        uint32_t crc = 0;
+        bool has = false;
+        for (int idx : module->m_outputs_index) {
+            if (idx < 0 || (size_t)idx >= m_model_context->m_variables.size()) {
+                continue;
+            }
+            TensorBase *t = m_model_context->m_variables[idx];
+            if (t && t->data) {
+                crc = esp_rom_crc32_le(crc, (const uint8_t *)t->data, t->get_bytes());
+                has = true;
+            }
+        }
+        trace.push_back(has ? crc : 0);
+    }
+    uint32_t arena_crc = 0;
+    if (internal && info.internal) {
+        arena_crc = esp_rom_crc32_le(arena_crc, internal, info.internal);
+    }
+    if (psram && info.psram) {
+        arena_crc = esp_rom_crc32_le(arena_crc, psram, info.psram);
+    }
+    trace.push_back(arena_crc);      // last entry: whole-arena CRC
+}
+
+const char *Model::module_name(size_t index)
+{
+    if (index < m_execution_plan.size() && m_execution_plan[index]) {
+        return m_execution_plan[index]->name;
+    }
+    return nullptr;
+}
+
 } // namespace dl
