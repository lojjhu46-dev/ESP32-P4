# JC-ESP32P4-M3-DEV board baseline (verified against vendor demos)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: 32MB hex-mode @200MHz (on-package W9xx)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# CPU 360MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# !! 本机 JC-ESP32P4-M3-DEV 的 P4 是 rev v1.3（<3.0）!!
# IDF 里 "rev<3.0" 与 "rev>=3.0" 互斥，默认(REV_MIN_301)无法烧到 v1.3 芯片
# （bootloader 会报 "requires chip revision in range [v3.1 - v3.99]"）。
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Wi-Fi via ESP32-C6 (ESP-Hosted over SDIO slot1: CMD=19 CLK=18 D0..D3=14..17, RST=GPIO54)
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# LVGL fonts / color depth
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_COLOR_DEPTH=16

CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y

# camera: SC2336 via MIPI (menuconfig: esp_cam_sensor -> SC2336)
# 分辨率必须压小：esp_video 把 ISP 时钟硬编码成 80MHz（esp_video_isp_device.c:40），
# 1080p30 RAW10(≈78MB/s) 喂不动会一直 "ISP: fifo overflow"；640x480@50(≈19MB/s) 稳。
# 对人脸检测 640x480 也足够（后续 ISP 输出 RGB565，可直接喂 esp-dl 的 RGB565LE）。
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW10_640X480_50FPS=y

# ISP 自动曝光/白平衡（AE/AWB）控制器：实测在我们这套配置下它会把曝光从默认的
# 满帧(994)压到 ~519 却不加增益，画面反而更暗；增益交给 APP_CAM_DEF_GAIN 手动设。
# ⚠️ 想再试 AE 时把它改回 y 对比（记得同时看 {"cmd":"cam"} 的 exp/gain 读数）。
# CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

CONFIG_APP_ENABLE_USB_LINK=y
CONFIG_APP_ENABLE_FACEAI=y
CONFIG_APP_ENABLE_IMG_PIPE=y
CONFIG_APP_ENABLE_STREAM=y
# JCLINK over Ethernet（网线直连 PC）：PC 是静态 192.168.33.53/23，板子 DHCP 4s 无租约后回落
CONFIG_APP_ENABLE_NET_LINK=y
CONFIG_APP_NETLINK_PORT=3333
CONFIG_APP_ETH_STATIC_IP="192.168.33.2"
CONFIG_APP_ETH_STATIC_NETMASK="255.255.254.0"

CONFIG_APP_FACEAI_DETECT_THR=50
CONFIG_APP_FACEAI_MATCH_THR=70
CONFIG_APP_FACEAI_MAX_BOXES=5

# 板子实测（2026-09-30）：
#  - MIPI-DSI 屏读取挂死：esp_lcd panel_io_dbi_rx_param() 在
#    mipi_dsi_host_ll_gen_is_read_cmd_busy() 里无限忙等（无超时），main 卡死 ->
#    TWDT。屏幕未接/未上电时必现。故无屏期先关显示（PC 当 HMI）。
CONFIG_APP_ENABLE_DISPLAY=n
#  - C6 协处理器 esp-hosted slave fw 2.3.2 vs 宿主驱动 3.0.7 主版本不匹配，
#    wifi 初始化不返回；先关掉 wifi 保底（后续需刷匹配的 C6 固件或降级宿主驱动）。
CONFIG_APP_ENABLE_WIFI=n

# ---- edge AI performance preset (esp-dl P4 recommendation) ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# tinyusb CDC device class
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=2048
